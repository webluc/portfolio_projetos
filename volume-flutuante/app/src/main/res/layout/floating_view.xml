<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble"
        android:contentDescription="@string/app_name"
        android:elevation="4dp"
        android:padding="14dp"
        android:src="@drawable/ic_volume_up" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Diminuir volume"
            android:src="@drawable/ic_volume_down" />

        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:progressTint="@color/white"
            android:thumbTint="@color/white" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Aumentar volume"
            android:src="@drawable/ic_volume_up" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Mudo"
            android:src="@drawable/ic_volume_off" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Recolher"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>
